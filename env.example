# Template for .env in the repository root. git ignores .env, so the token
# never reaches GitHub. Keep the file private with: chmod 600 .env
# The Slurm scripts and scripts/modal_hf_secret.sh read it automatically.

# Hugging Face token, fine-grained and read-only, with gated-repo read access.
HF_TOKEN=

# Slurm account to charge, as shown by: sacctmgr show assoc user=$USER format=account%30
ROAR_ACCOUNT=
# "standard" for a paid credit account, "sla-prio" for an allocation.
ROAR_PARTITION=standard

# Storage. Work is backed up (128 GB quota); scratch has no space quota but
# files older than 30 days are purged, so it only holds re-downloadable data.
MKP_WORK=/storage/work/$USER
MKP_SCRATCH=/scratch/$USER

# Module names, filled in after task T1 (see: module avail cuda, module avail python).
# MKP_CUDA_MODULE=
# MKP_PYTHON_MODULE=
